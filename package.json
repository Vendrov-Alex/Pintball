{
  "name": "pintball-survivor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wave-survival mobile game (iOS + Android) built with TypeScript, Canvas 2D and Capacitor.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "assets:icon": "node scripts/generate-icons.mjs",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "qa": "node scripts/simulate.mjs --runs 4 --sweep",
    "qa:shots": "node scripts/simulate.mjs --runs 1 --shots",
    "build:web": "node scripts/build-artifact.mjs",
    "qa:web": "npm run build:web && node scripts/check-web-build.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
